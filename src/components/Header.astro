---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
import Wordmark from '~/components/Wordmark.astro'
/*
 * Header — the MARQUEE STRIP.
 *
 * Not a centered top-nav bar (the sibling shell). This is an illuminated
 * theatre marquee: a bulb-chase strip runs across the top, then a lit frame
 * holds the wordmark, the program nav as marquee tiles, and a box-office
 * search chip. On mobile the tile row scrolls horizontally like a ticker.
 */
const path = Astro.url.pathname
const nav = [
  { href: '/', label: 'Now Showing', on: path === '/' },
  { href: '/series/', label: 'Serials', on: path.startsWith('/series') },
  { href: '/categories/', label: 'Genres', on: path.startsWith('/categories') },
  { href: '/about/', label: 'About', on: path.startsWith('/about') },
]
---

<StatusBanner />
<header class="marquee-strip" transition:persist="site-header">
  <div class="bulb-chase" aria-hidden="true"></div>
  <div class="container-page strip-inner">
    <div class="strip-brand">
      <Wordmark size={24} href="/" />
    </div>

    <nav class="tile-nav" aria-label="Primary">
      {nav.map((n) => (
        <a class="tile" href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>

    <div class="strip-box-office">
      <div class="strip-search"><MultiSearch client:idle /></div>
      <div class="strip-controls"><HeaderControls client:idle /></div>
    </div>
  </div>
  <div class="bulb-chase" aria-hidden="true"></div>
</header>

<style>
  .marquee-strip {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 90%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid color-mix(in oklab, var(--marquee-bulb) 32%, var(--rule));
  }

  /* the running bulb chase — a row of theatre bulbs top + bottom of the strip */
  .bulb-chase {
    height: 6px;
    background-image: radial-gradient(circle, var(--marquee-bulb) 0 1.5px, transparent 2px);
    background-size: 16px 6px;
    background-position: 0 50%;
    opacity: 0.85;
    box-shadow: 0 0 8px color-mix(in oklab, var(--marquee-bulb) 45%, transparent);
    animation: chase 1.2s steps(2) infinite;
  }
  @keyframes chase { to { background-position: 16px 50%; } }

  .strip-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    height: 60px;
  }
  .strip-brand { flex: 0 0 auto; }

  .tile-nav {
    display: flex;
    gap: 0.375rem;
    justify-self: center;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    max-width: 100%;
  }
  .tile-nav::-webkit-scrollbar { display: none; }

  .tile {
    flex: 0 0 auto;
    padding: 0.3rem 0.7rem;
    border: 1px solid color-mix(in oklab, var(--marquee-bulb) 22%, var(--rule));
    border-radius: 6px;
    background: color-mix(in oklab, var(--paper-2) 70%, transparent);
    font-family: var(--font-utility, var(--font-mono));
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-fast, 120ms) ease, border-color var(--dur-fast, 120ms) ease, box-shadow var(--dur-fast, 120ms) ease;
  }
  .tile:hover { color: var(--marquee-bulb); border-color: color-mix(in oklab, var(--marquee-bulb) 60%, transparent); }
  .tile[aria-current='page'] {
    color: var(--marquee-night, #14101f);
    background: var(--marquee-bulb);
    border-color: var(--marquee-bulb);
    box-shadow: var(--bulb-glow);
  }
  :root[data-theme='dark'] .tile[aria-current='page'],
  :root:not([data-theme='light']):not([data-theme='sepia']):not([data-theme='hc']) .tile[aria-current='page'] {
    color: #14101f;
  }

  .strip-box-office { display: inline-flex; align-items: center; gap: 0.5rem; justify-self: end; }

  @media (max-width: 767px) {
    .strip-inner {
      grid-template-columns: auto 1fr;
      grid-template-areas: 'brand box' 'nav nav';
      height: auto;
      padding-block: 0.5rem;
      row-gap: 0.5rem;
    }
    .strip-brand { grid-area: brand; }
    .strip-box-office { grid-area: box; }
    .tile-nav { grid-area: nav; justify-self: stretch; padding-bottom: 2px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bulb-chase { animation: none; }
  }
</style>
