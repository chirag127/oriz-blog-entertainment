---
/*
 * PosterTile — a repertory-cinema one-sheet for a single post.
 *
 * These posts carry no cover art, so the poster is TYPOGRAPHIC: a 2:3
 * one-sheet with a genre-tinted gradient wash, the title set large in Anton,
 * a top billing-block (genre + date) and a bottom runtime strip (reading
 * time). Hover lifts the sheet off the wall and lights its gold frame.
 */
import { postVertical, readingTimeFor, verticalLabel } from '~/lib/blog'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  /** feature = the oversized now-showing sheet; wall = grid tile. */
  variant?: 'wall' | 'feature'
}

const { post, variant = 'wall' } = Astro.props
const v = postVertical(post)
const rt = post.data.readingTime ?? readingTimeFor(post)
const cover = post.data.coverImage ?? post.data.heroImage
const date = post.data.pubDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })
---

<a class="poster" href={`/blog/${post.id}`} data-vertical={v} data-variant={variant}>
  <span class="poster-sheet">
    {cover && <img class="poster-still" src={cover} alt="" loading="lazy" decoding="async" />}
    <span class="poster-billing">
      <span class="poster-desk">{verticalLabel(v)}</span>
      <span class="poster-date">{date}</span>
    </span>
    <span class="poster-title">{post.data.title}</span>
    <span class="poster-dek">{post.data.description}</span>
    <span class="poster-strip">
      <span class="poster-rating" aria-hidden="true">★★★★☆</span>
      <span class="poster-runtime">{rt}</span>
    </span>
  </span>
</a>

<style>
  .poster {
    --v: var(--v-personal);
    display: block;
    text-decoration: none;
    color: var(--ink);
    perspective: 900px;
  }
  .poster[data-vertical='dev'] { --v: var(--v-dev); }
  .poster[data-vertical='finance'] { --v: var(--v-finance); }
  .poster[data-vertical='culture'] { --v: var(--v-culture); }
  .poster[data-vertical='health'] { --v: var(--v-health); }

  .poster-sheet {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.5rem;
    aspect-ratio: 2 / 3;
    padding: 1rem;
    border-radius: var(--radius-card);
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 90% at 20% 0%, color-mix(in oklab, var(--v) 42%, transparent), transparent 60%),
      linear-gradient(180deg, color-mix(in oklab, var(--v) 18%, var(--paper-2)) 0%, var(--paper-2) 62%);
    border: 1px solid color-mix(in oklab, var(--v) 30%, var(--rule));
    box-shadow: 0 1px 0 color-mix(in oklab, var(--marquee-bulb) 12%, transparent) inset;
    transition:
      transform var(--dur-base, 200ms) var(--ease-out),
      box-shadow var(--dur-base, 200ms) var(--ease-out),
      border-color var(--dur-base, 200ms) var(--ease-out);
  }
  /* film-grain speckle so the sheet reads as printed stock, not a flat card */
  .poster-sheet::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(color-mix(in oklab, var(--ink) 8%, transparent) 0.5px, transparent 0.5px);
    background-size: 4px 4px;
    opacity: 0.5;
    mix-blend-mode: overlay;
  }
  .poster-still {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  .poster:hover .poster-sheet,
  .poster:focus-visible .poster-sheet {
    transform: translateY(-8px) rotateX(3deg);
    border-color: var(--marquee-bulb);
    box-shadow:
      0 18px 40px -18px color-mix(in oklab, #000 80%, transparent),
      0 0 0 1px color-mix(in oklab, var(--marquee-bulb) 55%, transparent),
      var(--bulb-glow);
  }
  .poster:focus-visible { outline: none; }
  .poster:focus-visible .poster-sheet { outline: 2px solid var(--marquee-bulb); outline-offset: 3px; }

  .poster-billing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .poster-desk { color: var(--v); font-weight: 600; }

  .poster-title {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 0.92;
    color: var(--ink);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    text-wrap: balance;
  }
  .poster:hover .poster-title,
  .poster:focus-visible .poster-title { color: var(--marquee-bulb); }

  .poster-dek {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-mute);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  .poster-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.25rem;
    padding-top: 0.625rem;
    border-top: 1px solid color-mix(in oklab, var(--marquee-bulb) 25%, var(--rule));
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .poster-rating { color: var(--marquee-bulb); letter-spacing: 0.05em; }
  .poster-runtime { color: var(--ink-mute); }

  /* Feature one-sheet — the marquee headliner, wider + louder. */
  .poster[data-variant='feature'] .poster-sheet {
    aspect-ratio: 16 / 10;
  }
  .poster[data-variant='feature'] .poster-title {
    font-size: clamp(2.25rem, 6vw, 4rem);
    max-width: 18ch;
  }
  .poster[data-variant='feature'] .poster-dek {
    font-size: 1.0625rem;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    max-width: 60ch;
  }
  @media (min-width: 768px) {
    .poster[data-variant='feature'] .poster-sheet { aspect-ratio: 21 / 9; padding: 2rem; gap: 0.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-sheet { transition: none; }
    .poster:hover .poster-sheet,
    .poster:focus-visible .poster-sheet { transform: none; }
  }
</style>
