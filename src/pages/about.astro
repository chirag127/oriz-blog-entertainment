---
import BaseLayout from '~/layouts/BaseLayout.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chirag Singhal',
  url: 'https://oriz.in/about/',
  jobTitle: 'Software Engineer',
  description:
    'Software engineer specializing in scalable backend architectures, full-stack development, AI agents, and cloud-native deployments.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bhubaneswar',
    addressRegion: 'Odisha',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://github.com/chirag127',
    'https://x.com/chirag127',
    'https://linkedin.com/in/chirag127',
  ],
}
---

<BaseLayout
  title="About — Marquee"
  description="About Marquee — reviews, ranked lists, and honest post-mortems on film, TV, and pop culture by Chirag Singhal."
  jsonLd={jsonLd}
  hideSidebar={true}
>
  <header class="page-head">
    <p class="eyebrow"><a href="/">Marquee</a> / About</p>
    <h1>About</h1>
  </header>

  <article class="prose">
    <p class="lede">
      Marquee is a film, TV, and pop-culture blog — reviews, ranked lists, and
      honest post-mortems, written by Chirag Singhal. Part of the
      <a href="https://oriz.in">oriz</a> family of sites.
    </p>

    <h2>What gets posted here</h2>
    <p>
      What to stream and why it's worth your night, why a big film succeeded or
      flopped, and the moments that actually moved the culture. Opinionated,
      specific, and written for people who love the stuff — not for the
      algorithm.
    </p>

    <h2>How the reviews work</h2>
    <p>
      Every take is plain-spoken and argues its case. No spoilers without a
      warning, no score inflation, and no pretending a film is good because it
      was expensive. If something is worth your time, the post says why in a
      sentence you could repeat to a friend.
    </p>

    <h2>The oriz family</h2>
    <p>
      <strong>oriz</strong> is the umbrella for everything I publish — a family
      of static sites that share a sign-in, a design system, and a single
      principle: <em>useful, free, and quiet</em>. No newsletters you didn't
      ask for. No popups. No paid tier.
    </p>
    <p>
      Visit <a href="https://oriz.in">oriz.in</a> for the full directory of
      sites.
    </p>

    <h2>Contact</h2>
    <p>
      Email: <a href="mailto:whyiswhen@gmail.com">whyiswhen@gmail.com</a>.
      Or use the <a href="/contact/">contact form</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .page-head { padding-block: 3rem 1.5rem; border-bottom: 1px solid var(--color-border); max-width: var(--container-prose, 720px); margin-inline: auto; }
  .eyebrow { color: var(--color-fg-muted); font-size: 0.8125rem; margin: 0 0 0.5rem; }
  .eyebrow a { color: var(--color-fg-muted); text-decoration: none; }
  .eyebrow a:hover { color: var(--color-fg); }
  h1 { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 600; letter-spacing: -0.02em; margin: 0; }
  .prose { padding-block: 2.5rem 4rem; color: var(--color-prose); line-height: 1.75; font-size: 1.0625rem; max-width: var(--container-prose, 720px); margin-inline: auto; }
  .prose .lede { font-size: 1.1875rem; color: var(--color-fg); margin: 0 0 2rem; }
  .prose h2 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; color: var(--color-fg); margin: 2.5rem 0 1rem; }
  .prose p { margin: 0 0 1.25rem; }
  .prose a { color: var(--color-accent); }
</style>
