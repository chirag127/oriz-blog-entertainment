---
/**
 * /  — MARQUEE front-of-house. A POSTER WALL, not a text list.
 *
 * Above the fold: the marquee headline (thesis) framed by bulb-strips, then
 * the NOW SHOWING feature one-sheet. Below: the poster wall (a responsive
 * grid of typographic one-sheets), a COMING SOON serials reel, and a single
 * genre marquee row. No centered top-nav card grid — this is a theatre wall.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import PosterTile from '~/components/PosterTile.astro'
import SeriesSpine from '~/components/SeriesSpine.astro'
import {
  getCategoriesWithCounts,
  getPublishedPosts,
  getSeriesWithCounts,
  slugifyTag,
  verticalFor,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const feature = allPosts[0]
const wall = allPosts.slice(1)

const seriesAll = (await getSeriesWithCounts()).slice(0, 4)
const cats = await getCategoriesWithCounts()

const now = new Date()
const dateline = now.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout title="Marquee — film, TV & pop culture" description={SITE_CONFIG.description} jsonLd={jsonLd} hideSidebar>
  <div class="house">
    {/* Marquee headline — the thesis, framed by bulb-strips. */}
    <section class="headline" aria-label="Marquee">
      <hr class="bulb-strip" aria-hidden="true" />
      <p class="dateline">
        <span class="now">Now showing</span>
        <span class="sep" aria-hidden="true">·</span>
        <span>{dateline}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span><b>{allPosts.length}</b> features on the bill</span>
      </p>
      <h1 class="thesis">The screen is never just the screen.</h1>
      <p class="thesis-sub">Reviews, ranked lists, and honest post-mortems — why a show is worth your night, why a blockbuster went dark, and what a year of pop culture actually meant.</p>
      <hr class="bulb-strip" aria-hidden="true" />
    </section>

    {feature && (
      <section class="feature" aria-labelledby="feat-h">
        <h2 id="feat-h" class="rail-h">Feature presentation</h2>
        <PosterTile post={feature} variant="feature" />
      </section>
    )}

    {wall.length > 0 && (
      <section class="wall-sec" aria-labelledby="wall-h">
        <h2 id="wall-h" class="rail-h">On the wall</h2>
        <div class="poster-wall">
          {wall.map((p) => <PosterTile post={p} />)}
        </div>
        <p class="box-link"><a href="/archive/">Full back catalogue — all {allPosts.length} features →</a></p>
      </section>
    )}

    {seriesAll.length > 0 && (
      <section class="reel" aria-labelledby="reel-h">
        <h2 id="reel-h" class="rail-h">Coming soon — serials</h2>
        <ul class="reel-list">
          {seriesAll.map(({ series, count }) => (
            <li>
              <a class="reel-row" href={`/series/${slugifyTag(series)}/`}>
                <span class="reel-name">{series}</span>
                <SeriesSpine total={count + 1} published={count} current={count} size="md" />
                <span class="reel-count">{count} {count === 1 ? 'episode' : 'episodes'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {cats.length > 0 && (
      <section class="genres" aria-labelledby="gen-h">
        <h2 id="gen-h" class="rail-h">By genre</h2>
        <p class="genre-row">
          {cats.map((c, i) => (
            <>
              {i > 0 && <span class="gdot" aria-hidden="true">·</span>}
              <a href={`/categories/${slugifyTag(c.category)}/`} class="glink" data-vertical={verticalFor(c.category)}>
                <span class="gname">{c.category}</span><span class="gcount">({c.count})</span>
              </a>
            </>
          ))}
        </p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .house { max-width: var(--container-page, 1100px); margin-inline: auto; padding-inline: clamp(1.25rem, 4vw, 2rem); }

  /* ── Headline ─────────────────────────────────────────────────────── */
  .headline { padding-block: clamp(1.5rem, 5vw, 3rem); text-align: center; }
  .dateline {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-mute);
    margin: 1.25rem 0;
  }
  .dateline .now { color: var(--marquee-neon); font-weight: 600; }
  .dateline .sep { color: var(--rule-strong, var(--rule)); }
  .dateline b { color: var(--marquee-bulb); font-weight: 600; }
  .thesis {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(2.5rem, 8vw, 5.25rem); line-height: 0.95; letter-spacing: 0.005em;
    text-transform: uppercase; color: var(--ink); margin: 0 auto; max-width: 15ch; text-wrap: balance;
  }
  .thesis-sub {
    font-family: var(--font-serif); font-size: clamp(1.0625rem, 2vw, 1.3125rem); line-height: 1.5;
    color: var(--ink-mute); margin: 1.25rem auto 0; max-width: 56ch; text-wrap: pretty;
  }

  /* ── Rail heads ───────────────────────────────────────────────────── */
  .rail-h {
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--ink-mute); font-weight: 500; margin: 0 0 1rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .rail-h::after { content: ''; flex: 1; height: 1px; background: color-mix(in oklab, var(--marquee-bulb) 24%, var(--rule)); }

  .feature { padding-block: 1.5rem 0.5rem; }

  /* ── Poster wall ──────────────────────────────────────────────────── */
  .wall-sec { padding-block: 2rem 0.5rem; }
  .poster-wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }
  @media (max-width: 520px) {
    .poster-wall { grid-template-columns: repeat(2, 1fr); gap: 0.875rem; }
  }
  .box-link { margin: 1.5rem 0 0; font-family: var(--font-sans); font-size: 13.6px; }
  .box-link a { color: var(--ink-mute); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--rule); }
  .box-link a:hover { color: var(--marquee-bulb); text-decoration-color: var(--marquee-bulb); }

  /* ── Serials reel ─────────────────────────────────────────────────── */
  .reel { padding-block: 2.5rem 0.5rem; }
  .reel-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .reel-row {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 1rem; align-items: center;
    padding: 0.75rem 0.875rem; border: 1px solid var(--rule); border-radius: var(--radius-card);
    background: color-mix(in oklab, var(--paper-2) 55%, transparent);
    color: var(--ink); text-decoration: none;
    transition: border-color var(--dur-fast, 120ms) ease, background var(--dur-fast, 120ms) ease;
  }
  .reel-row:hover { border-color: color-mix(in oklab, var(--marquee-bulb) 55%, transparent); background: var(--paper-2); }
  .reel-name { font-family: var(--font-serif); font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .reel-count { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--ink-mute); white-space: nowrap; }
  @media (max-width: 560px) {
    .reel-row { grid-template-columns: minmax(0,1fr) auto; grid-template-areas: 'name count' 'spine spine'; row-gap: 0.4rem; }
    .reel-name { grid-area: name; } .reel-count { grid-area: count; text-align: right; }
    .reel-row > :global(*:nth-child(2)) { grid-area: spine; }
  }

  /* ── Genres ───────────────────────────────────────────────────────── */
  .genres { padding-block: 2.5rem 1rem; }
  .genre-row { margin: 0; line-height: 2; }
  .glink { --v: var(--v-personal); color: var(--ink); text-decoration: none; margin-inline: 0.125rem; }
  .glink[data-vertical='dev'] { --v: var(--v-dev); }
  .glink[data-vertical='finance'] { --v: var(--v-finance); }
  .glink[data-vertical='culture'] { --v: var(--v-culture); }
  .glink[data-vertical='health'] { --v: var(--v-health); }
  .glink:hover .gname { color: var(--v); }
  .gname { font-family: var(--font-serif); font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
  .gcount { color: var(--ink-mute); font-family: var(--font-mono); font-size: 11px; margin-left: 0.25rem; }
  .gdot { color: var(--rule-strong, var(--rule)); margin-inline: 0.625rem; }
</style>
